---
import Footer from "../components/footer.astro";
import Header from "../components/header.astro";
import "../styles/global.css";
import {
	getLocaleFromUrl,
	getUrlWithoutLocale,
	languages,
	useTranslatedPath,
} from "../utilities/i18n";
import { objectKeys } from "../utilities/object";

type Props = {
	title: string;
	description: string;
	ogImage?: string;
	ogImageAlt?: string;
};
let { title, description, ogImage, ogImageAlt } = Astro.props;

let locale = getLocaleFromUrl(Astro.url);
let dir = languages[locale]?.dir ?? "ltr";

let pathWithoutLocale = getUrlWithoutLocale(Astro.url);
let alternates = objectKeys(languages).map((lang) => ({
	hreflang: lang,
	href: new URL(useTranslatedPath(lang)(pathWithoutLocale), Astro.site).href,
}));
let defaultHref = new URL(pathWithoutLocale, Astro.site).href;
let canonical = new URL(Astro.url.pathname, Astro.site).href;
let ogLocale = locale === "en" ? "en_US" : locale.replace("-", "_");
---

<!doctype html>
<html
	lang={locale}
	dir={dir}
	class="bg-base text-text antialiased selection:bg-muted/20 selection:text-text max-sm:text-lg"
>
	<head>
		<meta charset="UTF-8" />
		<meta
			name="viewport"
			content="width=device-width, initial-scale=1, viewport-fit=cover"
		/>
		<link rel="icon" href="/favicon.png" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<meta property="og:site_name" content="Rosé Pine" />
		<link rel="canonical" href={canonical} />
		<meta property="og:url" content={canonical} />
		<meta property="og:locale" content={ogLocale} />
		{
			objectKeys(languages)
				.filter((lang) => lang !== locale)
				.map((lang) => (
					<meta
						property="og:locale:alternate"
						content={lang === "en" ? "en_US" : lang.replace("-", "_")}
					/>
				))
		}
		{
			alternates.map(({ hreflang, href }) => (
				<link rel="alternate" hreflang={hreflang} href={href} />
			))
		}
		<link rel="alternate" hreflang="x-default" href={defaultHref} />
		<!-- Bing Webmaster verification, used to populate DuckDuckGo -->
		<meta name="msvalidate.01" content="38A9FFCE6888A7C1C245B7B24C1CCFB2" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{ogImage && <meta property="og:image" content={ogImage} />}
		{
			ogImage && ogImageAlt && (
				<meta property="og:image:alt" content={ogImageAlt} />
			)
		}
		{ogImage && <meta name="twitter:card" content="summary_large_image" />}
		<title>{title} – Rosé Pine</title>

		<script>
			if (localStorage.theme) {
				document.documentElement.dataset.theme = localStorage.theme;
			} else {
				delete document.documentElement.dataset.theme;
			}

			document.addEventListener("click", (e) => {
				const target = e.target;
				if ((target as HTMLElement).closest("a")) return;

				const open = document.querySelectorAll("details[open]");
				if (!open.length) return;

				open.forEach((d) => {
					if (!d.contains(target as Node)) {
						d.removeAttribute("open");
						// Re-calculate heights after closing
						(d as HTMLElement).offsetHeight;
					}
				});
			});
		</script>
	</head>
	<body>
		<div class="overflow-clip">
			<div
				class="sr-only gap-3 focus-within:not-sr-only focus-within:fixed focus-within:inset-s-3 focus-within:top-3 focus-within:flex focus-within:items-center"
			>
				<a href="#content" class="rounded bg-surface p-1.5 font-medium"
					>Skip to main content</a
				>
				<a href="#footer-nav" class="rounded bg-surface p-1.5 font-medium"
					>Skip to footer navigation</a
				>
			</div>

			<div aria-hidden="true" class="relative mx-auto">
				<div
					class="pointer-events-none absolute -inset-e-60 -top-44 -z-10 h-60 w-xl -rotate-12 transform-gpu rounded-full bg-linear-to-r from-gold/50 from-30% via-rose/70 via-70% to-iris blur-3xl md:inset-e-0"
				>
				</div>
			</div>

			<div class="flex min-h-dvh flex-col gap-page-start">
				<div>
					<Header />
				</div>

				<main id="content" class="max-w-screen flex-1">
					<slot />
				</main>
			</div>

			<Footer />
		</div>
	</body>
</html>
