---
import Page from "../layouts/page.astro";
---

<Page title="Page not found" description="This page does not exist.">
	<section class="wrapper stack min-h-[58svh] flex-1">
		<p class="font-mono text-7xl font-bold tracking-tight text-love">404</p>
		<h1 class="text-2xl font-bold tracking-tight">Page not found</h1>
		<p class="text-subtle">
			The page you're looking for doesn't exist or has moved.
		</p>
		<a href="/" class="button button-secondary">Back to home</a>
	</section>
</Page>
