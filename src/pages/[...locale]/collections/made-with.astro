---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { ArrowNEIcon } from "../../../components/icons";
import IntroSection from "../../../components/intro-section.astro";
import Page from "../../../layouts/page.astro";
import { useTranslations, withLocalePaths } from "../../../utilities/i18n";

export async function getStaticPaths() {
	return await withLocalePaths();
}

let { locale = "en" } = Astro.params;
let t = useTranslations(locale);

const madeWith = await getCollection("madeWith");
---

<Page title={t("made-with.title")} description={t("made-with.description")}>
	<IntroSection
		headline={t("made-with.title")}
		subheadline={t("made-with.description")}
	/>

	<section class="animate-enter wrapper" style="--stagger: 3">
		<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
			{
				madeWith.map((site) => (
					<article class="card">
						<Image
							src={site.data.image}
							alt={site.data.name}
							width={1000}
							height={600}
							class="card-media"
						/>
						<div class="card-body">
							<a
								aria-label="Visit project"
								href={site.data.url}
								class="flex items-center justify-between gap-1.5"
							>
								<span class="font-medium italic">{site.data.name}</span>
								<ArrowNEIcon size={16} class="shrink-0" />
							</a>
						</div>
					</article>
				))
			}
		</div>
	</section>
</Page>
