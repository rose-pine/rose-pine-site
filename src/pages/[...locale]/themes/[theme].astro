---
import Avatar from "../../../components/avatar.svelte";
import { ArrowNEIcon } from "../../../components/icons";
import ThemeCard from "../../../components/theme-card.svelte";
import ThemeIcon from "../../../components/theme-icon.svelte";
import { getAllRepos } from "../../../data";
import Page from "../../../layouts/page.astro";
import type { Repo } from "../../../types/theme";
import {
	formatDate,
	getLocaleFromUrl,
	useTranslatedPath,
	useTranslations,
	withLocalePaths,
} from "../../../utilities/i18n";
import {
	categoryColorMap,
	categoryPressedColorMap,
	isValidIconCategory,
} from "../../../utilities/icons";

export async function getStaticPaths() {
	const repos = await getAllRepos();
	const entries = repos.map((repo) => {
		const relatedRepos = repos.filter(
			(r) => repo.related.includes(r.slug) || r.related.includes(repo.slug),
		);
		return {
			params: { theme: repo.slug },
			props: { repo, relatedRepos },
		};
	});
	return await withLocalePaths(entries);
}

let locale = getLocaleFromUrl(Astro.url);
let t = useTranslations(locale);
let translatePath = useTranslatedPath(locale);

let { repo, relatedRepos = [] as Repo[] } = Astro.props;

let tonalClass = isValidIconCategory(repo.category)
	? categoryColorMap[repo.category]
	: "tonal-iris";
let tonalPressedClass = isValidIconCategory(repo.category)
	? categoryPressedColorMap[repo.category]
	: "hover:tonal-pressed-iris";
---

<Page
	title={repo.name}
	description={`Soho vibes for ${repo.name}`}
	ogImage={repo.ogImage}
	ogImageAlt={`Rosé Pine for ${repo.name}`}
>
	<section class="animate-enter wrapper" style="--stagger: 1">
		<div class="card">
			<div class="card-body [--_gap:--spacing(12)]">
				<div class="flex items-center justify-between gap-3">
					<a href={translatePath("/themes")} class="button button-secondary">
						<div class="button-icon">
							<span class="ltr:block rtl:hidden">&larr;</span>
							<span class="ltr:hidden rtl:block">&rarr;</span>
						</div>
						{t("themes.title")}
					</a>

					<a
						href={repo.url}
						class="button"
						class:list={[tonalClass, tonalPressedClass]}
					>
						<ArrowNEIcon class="button-icon" />
						Visit repository
					</a>
				</div>

				<div class="flex items-center gap-4">
					{
						isValidIconCategory(repo.category) && (
							<ThemeIcon category={repo.category} size="lg" />
						)
					}
					<div class="min-w-0">
						<h1 class="text-2xl font-bold tracking-tight">{repo.name}</h1>
						<div class="mt-2 flex flex-wrap items-center gap-3 text-sm">
							<span
								class:list={[
									"rounded-full px-2.5 py-0.5 text-xs font-semibold capitalize",
									isValidIconCategory(repo.category)
										? categoryColorMap[repo.category]
										: "tonal-subtle",
								]}
							>
								{repo.category}
							</span>
							{
								repo.updatedAt && (
									<span class="text-subtle italic">
										Updated {formatDate(repo.updatedAt, locale)}
									</span>
								)
							}
						</div>
					</div>
				</div>

				{
					repo.subthemes.length > 0 && (
						<div>
							<h2 class="mb-4 text-lg font-semibold">{t("themes.title")}</h2>
							<ul role="list" class="auto-grid-36 gap-3">
								{repo.subthemes.map((subtheme) => (
									<li>
										<a
											href={subtheme.url}
											class="button button-secondary w-full"
										>
											{subtheme.name}
										</a>
									</li>
								))}
							</ul>
						</div>
					)
				}

				{
					repo.contributors.length > 0 && (
						<div>
							<h2 class="mb-4 text-lg font-semibold">
								{t("themes.contributors")}
							</h2>
							<ul role="list" class="flex flex-wrap gap-3">
								{repo.contributors.map((contributor) => (
									<li>
										<a
											aria-label={`Learn more about ${contributor.name}`}
											href={contributor.url}
											class="transition hover:opacity-80"
										>
											<Avatar
												src={contributor.image}
												alt={contributor.name}
												size={44}
											/>
										</a>
									</li>
								))}
							</ul>
						</div>
					)
				}

				{
					relatedRepos.length > 0 && (
						<div>
							<h2 class="mb-4 text-lg font-semibold">Related themes</h2>
							<div class="grid gap-3 md:grid-cols-2 lg:grid-cols-3">
								{relatedRepos.map((related) => (
									<ThemeCard client:only="svelte" theme={related} />
								))}
							</div>
						</div>
					)
				}
			</div>
		</div>
	</section>
</Page>
