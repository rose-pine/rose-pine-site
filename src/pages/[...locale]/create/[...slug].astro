---
import { getCollection, getEntry, render } from "astro:content";
import Avatar from "../../../components/avatar.svelte";
import { CalendarIcon } from "../../../components/icons";
import Page from "../../../layouts/page.astro";
import {
	defaultLocale,
	formatDate,
	isLocale,
	languages,
	showDefaultLocale,
	useTranslatedPath,
	useTranslations,
} from "../../../utilities/i18n";
import { objectEntries } from "../../../utilities/object";

export async function getStaticPaths() {
	const pages = await getCollection("guides", ({ data }) => {
		return import.meta.env.PROD ? data.draft !== true : true;
	});

	return pages.map((page) => {
		const [first, ...rest] = page.id.split("/");
		const locale = isLocale(first) ? first : defaultLocale;
		return {
			params: {
				locale:
					!showDefaultLocale && locale === defaultLocale ? undefined : locale,
				slug: rest.join("/") || undefined,
			},
			props: { page },
		};
	});
}

const { locale = "en" } = Astro.params;
let t = useTranslations(locale);
let translatePath = useTranslatedPath(locale);

const { page } = Astro.props;
const author = await getEntry(page.data.author);
const { Content } = await render(page);

const slug = page.id.split("/").slice(1).join("/");
const allPages = await getCollection("guides");
const displayNames = new Intl.DisplayNames([locale, "en"], {
	type: "language",
});
const availableLanguages = objectEntries(languages)
	.filter(
		([code]) =>
			code !== locale && allPages.some((page) => page.id === `${code}/${slug}`),
	)
	.map(([code, { name }]) => ({
		name,
		localisedName: displayNames.of(code) ?? name,
		url: useTranslatedPath(code)(`/create/${slug}`),
	}));

const publishedAt = formatDate(page.data.publishedAt, locale);
const updatedAt = formatDate(page.data.updatedAt, locale);
---

<Page title={page.data.title} description={page.data.description}>
	<div class="wrapper">
		<div
			class="animate-enter mb-12 flex items-center justify-between gap-3"
			style="--stagger: 1"
		>
			<a href={translatePath("/create")} class="button button-secondary">
				<div class="button-icon">
					<span class="ltr:block rtl:hidden">&larr;</span>
					<span class="ltr:hidden rtl:block">&rarr;</span>
				</div>
				{t("create.title")}
			</a>
		</div>

		<article class="mx-auto w-full max-w-prose">
			<h1
				class="animate-enter mb-4 max-w-2xl text-5xl font-bold tracking-tight text-balance"
				style="--stagger: 1"
			>
				{page.data.title}
			</h1>

			<p
				class="animate-enter mb-4 max-w-md font-serif text-lg text-subtle italic"
				style="--stagger: 2"
			>
				{page.data.description}
			</p>

			{
				updatedAt || publishedAt || author ? (
					<div
						class="animate-enter mb-8 flex items-center gap-6"
						style="--stagger: 2.25"
					>
						{(updatedAt || publishedAt) && (
							<div class="flex items-center gap-2">
								<CalendarIcon size={18} class="text-subtle" />
								<span class="font-medium">{updatedAt ?? publishedAt}</span>
							</div>
						)}

						{author && (
							<a href={author.data.url} class="flex items-center gap-2">
								<Avatar src={author.data.image} alt={author.data.name} />
								{author.data.name}
							</a>
						)}
					</div>
				) : (
					<div class="h-4" />
				)
			}

			<div class="animate-enter prose prose-lg mb-8" style="--stagger: 2.5">
				<Content />
			</div>

			{
				availableLanguages.length > 0 && (
					<>
						<div class="my-8 h-px bg-muted/20" />

						<p class="mb-8 text-lg">
							{t("create.also_available_in")}&nbsp;
							{availableLanguages.map((language, index) => (
								<>
									<a href={language.url} class="link">
										{language.name}
										{language.name !== language.localisedName && (
											<> ({language.localisedName})</>
										)}
									</a>
									{index < availableLanguages.length - 1 && <span>, </span>}
								</>
							))}
						</p>
					</>
				)
			}
		</article>
	</div>
</Page>
