---
import { getCollection, getEntry, render } from "astro:content";
import Avatar from "../../../components/avatar.svelte";
import { CalendarIcon, EditIcon } from "../../../components/icons";
import Page from "../../../layouts/page.astro";
import {
	buildDisplayNames,
	defaultLocale,
	formatDate,
	isLocale,
	languages,
	parseLocalisedId,
	useTranslatedPath,
	useTranslations,
	withLocalePaths,
} from "../../../utilities/i18n";
import { objectKeys } from "../../../utilities/object";

export async function getStaticPaths() {
	const pages = await getCollection(
		"guides",
		({ data }) => !import.meta.env.PROD || data.draft !== true,
	);

	const pagesById = new Map(pages.map((page) => [page.id, page]));
	const slugs = [
		...new Set(pages.map((page) => parseLocalisedId(page.id).slug)),
	];

	return await withLocalePaths((locale) => {
		const contentLocale = locale ?? defaultLocale;

		return slugs.flatMap((slug) => {
			const page =
				pagesById.get(`${contentLocale}/${slug}`) ??
				pagesById.get(`${defaultLocale}/${slug}`);

			return page ? [{ params: { slug }, props: { page } }] : [];
		});
	});
}

const { locale = defaultLocale, slug } = Astro.params as {
	locale?: string;
	slug: string;
};
const uiLocale = isLocale(locale) ? locale : defaultLocale;
const uiDir = languages[uiLocale].dir;
let t = useTranslations(uiLocale);
let translatePath = useTranslatedPath(uiLocale);
let languageNames = buildDisplayNames(uiLocale);

const { page } = Astro.props;
const { locale: contentLocale } = parseLocalisedId(page.id);
const contentDir = languages[contentLocale].dir;
const isFallback = contentLocale !== uiLocale;

const author = await getEntry(page.data.author);
const { Content } = await render(page);

const allPages = await getCollection(
	"guides",
	({ data }) => !import.meta.env.PROD || data.draft !== true,
);
const translatedLocales = objectKeys(languages).filter((code) =>
	allPages.some((page) => page.id === `${code}/${slug}`),
);

const availableLanguages = translatedLocales
	.filter((code) => code !== contentLocale)
	.map((code) => ({
		name: languages[code].name,
		localisedName: languageNames.of(code) ?? languages[code].name,
		url: useTranslatedPath(code)(`/create/${slug}`),
	}));

const canonical = new URL(`/create/${slug}/`, Astro.site).href;

const publishedAt = formatDate(page.data.publishedAt, uiLocale);
const updatedAt = formatDate(page.data.updatedAt, uiLocale);
---

<Page
	title={page.data.title}
	description={page.data.description}
	availableLocales={translatedLocales}
	canonical={isFallback ? canonical : undefined}
	noindex={isFallback}
>
	<div class="wrapper">
		<div
			class="animate-enter mb-12 flex items-center justify-between gap-3"
			style="--stagger: 1"
		>
			<a href={translatePath("/create")} class="button button-secondary">
				<div class="button-icon">
					<span class="ltr:block rtl:hidden">&larr;</span>
					<span class="ltr:hidden rtl:block">&rarr;</span>
				</div>
				{t("create.title")}
			</a>
		</div>

		<article
			class="mx-auto w-full max-w-prose"
			lang={contentLocale}
			dir={contentDir}
		>
			{
				isFallback && (
					<p
						class="animate-enter mb-8 font-medium text-love"
						style="--stagger: 0.5"
					>
						{t("create.fallback_notice", {
							language: languages[uiLocale].name,
						})}
					</p>
				)
			}

			<h1
				class="animate-enter mb-4 max-w-2xl text-5xl font-bold tracking-tight text-balance"
				style="--stagger: 1"
			>
				{page.data.title}
			</h1>

			<p
				class="animate-enter mb-4 max-w-md font-serif text-lg text-subtle italic"
				style="--stagger: 2"
			>
				{page.data.description}
			</p>

			{
				updatedAt || publishedAt || author ? (
					<div
						class="animate-enter mb-8 flex items-center gap-6"
						style="--stagger: 2.25"
					>
						{(updatedAt || publishedAt) && (
							<div class="flex items-center gap-2">
								<CalendarIcon size={18} class="text-subtle" />
								<span class="font-medium">{updatedAt ?? publishedAt}</span>
							</div>
						)}

						{author && (
							<a href={author.data.url} class="flex items-center gap-2">
								<Avatar src={author.data.image} alt={author.data.name} />
								{author.data.name}
							</a>
						)}
					</div>
				) : (
					<div class="h-4" />
				)
			}

			<div class="animate-enter prose prose-lg mb-8" style="--stagger: 2.5">
				<Content />

				<div class="my-8 h-0.5 bg-overlay"></div>

				{
					availableLanguages.length > 0 && (
						<p class="mb-8 text-lg" lang={uiLocale} dir={uiDir}>
							{t("create.also_available_in")}&nbsp;
							{availableLanguages.map((language, index) => (
								<>
									<a href={language.url} class="link">
										{language.name}
										{language.name !== language.localisedName && (
											<> ({language.localisedName})</>
										)}
									</a>
									{index < availableLanguages.length - 1 && <span>, </span>}
								</>
							))}
						</p>
					)
				}

				<a
					href={`https://github.com/rose-pine/rose-pine-site/edit/main/${page.filePath}`}
					class="button button-secondary"
				>
					<span class="pbe-px">Edit on GitHub</span>
					<EditIcon />
				</a>
			</div>
		</article>
	</div>
</Page>
