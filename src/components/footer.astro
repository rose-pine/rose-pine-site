---
import BadgeIcon from "../assets/badge.svg";
import {
	getLocaleFromUrl,
	getUrlWithoutLocale,
	languages,
	useTranslatedPath,
	useTranslations,
} from "../utilities/i18n";
import { objectEntries } from "../utilities/object";
import { ChevronDownIcon, DocumentIcon } from "./icons";
import LoveAll from "./love-all.astro";
import SiteAppearance from "./site-appearance.svelte";

let locale = getLocaleFromUrl(Astro.url);
let t = useTranslations(locale);
let translatePath = useTranslatedPath(locale);

let displayNames = new Intl.DisplayNames([locale, "en"], {
	type: "language",
});

let resourceItems = [
	{
		name: t("nav.resource.create"),
		href: translatePath("/create/create-a-theme"),
	},
	{
		name: t("nav.resource.submit"),
		href: "/new",
	},
	{
		name: t("nav.resource.translate"),
		href: translatePath("/create/add-a-translation"),
	},
];

let collectionItems = [
	{
		name: t("nav.collection.photography"),
		href: translatePath("/collections/photography"),
	},
	{
		name: t("nav.collection.made-with"),
		href: translatePath("/collections/made-with"),
	},
];

let socialItems = [
	{ name: "Email", href: "mailto:hi@rosepinetheme.com" },
	{ name: "GitHub", href: "https://github.com/rose-pine" },
	{ name: "Discord", href: "/discord" },
];
---

<footer class="wrapper py-page-start">
	<nav id="footer-nav" aria-label={t("nav.footer_label")}>
		<div class="cluster-20 pbe-page-start *:last:ms-auto">
			<section class="stack">
				<h2>{t("nav.resources")}</h2>
				<ul class="stack-2">
					{
						resourceItems.map((item) => (
							<li>
								<a href={item.href}>{item.name}</a>
							</li>
						))
					}
				</ul>
			</section>

			<section class="stack">
				<h2>{t("nav.collections")}</h2>
				<ul class="stack-2">
					{
						collectionItems.map((item) => (
							<li>
								<a href={item.href}>{item.name}</a>
							</li>
						))
					}
				</ul>
			</section>

			<section class="stack">
				<h2>{t("nav.social")}</h2>
				<ul class="stack-2">
					{
						socialItems.map((item) => (
							<li>
								<a href={item.href}>{item.name}</a>
							</li>
						))
					}
				</ul>
			</section>

			<div class="cluster items-start justify-end">
				<details class="group/dropdown dropdown dropdown-up">
					<summary class="button button-ghost">
						<span
							>{
								languages[locale as keyof typeof languages]?.name ?? "English"
							}</span
						>
						<ChevronDownIcon
							size={14}
							class="transition-transform duration-150 group-open/dropdown:rotate-180"
						/>
					</summary>
					<div class="dropdown-menu">
						{
							objectEntries(languages).map(([lang, { name }]) => {
								let localisedName = displayNames.of(lang) ?? name;
								return (
									<a
										href={`${translatePath(getUrlWithoutLocale(Astro.url), lang)}?lang=${lang}`}
										class="dropdown-item"
									>
										<div class="flex flex-col leading-tight">
											<span>{name}</span>
											{name !== localisedName && (
												<span class="text-xs text-subtle">{localisedName}</span>
											)}
										</div>
									</a>
								);
							})
						}
					</div>
				</details>

				<SiteAppearance client:only="svelte" />
				<a href={translatePath("/colophon")} class="button button-ghost">
					<DocumentIcon size={16} />
					Colophon
				</a>
				<a href={translatePath("/")}>
					<BadgeIcon width="36" height="36" />
					<span class="sr-only">{t("nav.home")}</span>
				</a>
			</div>
		</div>
	</nav>

	<div class="cluster justify-center pbs-page-start">
		<LoveAll />
	</div>
</footer>

<style>
	section {
		& h2 {
			font-weight: 500;
		}
		& a {
			color: var(--color-subtle);
			text-decoration: none;
			text-underline-offset: 2px;

			&:hover {
				text-decoration: underline;
			}
		}
	}
</style>
