---
import BadgeIcon from "../assets/badge.svg";
import { getFeaturedRepos, getSortedRepos } from "../data";
import palette from "../data/palette.json";
import {
	getLocaleFromUrl,
	useTranslatedPath,
	useTranslations,
} from "../utilities/i18n";
import CommandMenu, { type Group } from "./command-menu.svelte";
import { ChevronDownIcon, SparklesIcon } from "./icons";

let locale = getLocaleFromUrl(Astro.url);
let t = useTranslations(locale);
let translatePath = useTranslatedPath(locale);

const [sortedRepos, featuredRepos] = await Promise.all([
	getSortedRepos(),
	getFeaturedRepos(),
]);

const repoSlugs = sortedRepos.map((r) => r.slug);

let menuItems = [
	{ name: t("nav.themes"), href: translatePath("/themes") },
	{ name: t("nav.palette"), href: translatePath("/palette") },
];

let collectionItems = [
	{
		name: t("footer.collection.photography"),
		href: translatePath("/collections/photography"),
	},
	{
		name: t("footer.collection.made-with"),
		href: translatePath("/collections/made-with"),
	},
];

let searchGroups: Group[] = [
	{
		heading: t("command.pages"),
		kind: "icon",
		items: [
			{
				label: t("nav.home"),
				searchText: t("nav.home").toLowerCase(),
				href: translatePath("/"),
				icon: "home",
			},
			{
				label: t("nav.themes"),
				searchText: t("nav.themes").toLowerCase(),
				href: translatePath("/themes"),
				icon: "folder",
			},
			{
				label: t("nav.palette"),
				searchText: t("nav.palette").toLowerCase(),
				href: translatePath("/palette"),
				icon: "rainbow",
			},
			{
				label: t("nav.create"),
				searchText: t("nav.create").toLowerCase(),
				href: translatePath("/create"),
				icon: "sparkles",
			},
		],
	},
	{
		heading: t("nav.themes"),
		kind: "theme",
		items: sortedRepos.map((repo) => ({
			label: repo.name,
			searchText: repo.searchText,
			href: translatePath(`/themes/${repo.slug}`),
			icon: repo.category,
			subthemes: repo.subthemes,
		})),
	},
	{
		heading: t("nav.palette"),
		kind: "color",
		items: palette.main.map((color) => ({
			label: color.name,
			searchText: color.name.toLowerCase(),
			href: translatePath(`/palette/${color.slug}`),
			icon: color.slug,
		})),
	},
	{
		heading: t("command.community"),
		kind: "icon",
		items: [
			{
				label: "Email",
				searchText: "email",
				href: "mailto:hi@rosepinetheme.com",
				icon: "inbox",
			},
			{
				label: "Discord",
				searchText: "discord",
				href: "/discord",
				icon: "discord",
			},
			{
				label: "GitHub",
				searchText: "github",
				href: "https://github.com/rose-pine",
				icon: "github",
			},
		],
	},
];

let defaultGroups: Group[] = [
	searchGroups[0],
	{
		heading: t("command.featured_themes"),
		kind: "theme",
		items: featuredRepos.map((repo) => ({
			label: repo.name,
			searchText: repo.searchText,
			href: translatePath(`/themes/${repo.slug}`),
			icon: repo.category,
		})),
	},
	...searchGroups.slice(2),
];
---

<header
	class="relative wrapper mt-page-start flex items-center gap-6 py-card-gutters-half"
>
	<a
		title={t("nav.home")}
		href={translatePath("/")}
		class="z-50 flex shrink-0 items-center gap-3 rounded-lg"
	>
		<BadgeIcon class="size-(--badge-size) shrink-0" />
		<span class="pe-1 font-serif text-xl font-medium tracking-tight italic"
			>Rosé Pine</span
		>
	</a>

	<div class="flex flex-1 items-center justify-end">
		<CommandMenu
			client:only="svelte"
			{defaultGroups}
			{searchGroups}
			{repoSlugs}
		/>
	</div>

	<nav aria-label={t("header.nav_label")} class="hidden md:block">
		<ul class="flex items-center gap-1.5">
			{
				menuItems.map((item) => (
					<li>
						<a
							href={item.href}
							class="flex h-8 items-center rounded-lg px-(--nav-item-space) font-medium transition hover:bg-muted/10"
						>
							{item.name}
						</a>
					</li>
				))
			}
			<li>
				<details class="group/dropdown dropdown">
					<summary
						class="flex h-8 items-center gap-1 rounded-lg px-(--nav-item-space) font-medium transition hover:bg-muted/10"
					>
						<span>{t("nav.collections")}</span>
						<ChevronDownIcon
							size={14}
							class="transition-transform duration-150 group-open/dropdown:rotate-180"
						/>
					</summary>
					<div class="dropdown-menu">
						{
							collectionItems.map((item) => (
								<a href={item.href} class="dropdown-item">
									{item.name}
								</a>
							))
						}
					</div>
				</details>
			</li>
			<li class="ps-3">
				<a
					href={translatePath("/create")}
					class="group/cta flex h-8 shrink-0 items-center gap-2 rounded-lg border-2 border-text ps-3 pe-4 font-serif font-medium italic transition hover:border-gold hover:bg-gold/10 hover:text-gold"
				>
					<SparklesIcon
						size={16}
						class="transition-transform group-hover/cta:-rotate-3"
					/>
					<span class="pb-px">{t("nav.create")}</span>
				</a>
			</li>
		</ul>
	</nav>

	<details class="animate-details group/menu block select-none md:hidden">
		<summary
			class="relative z-50 flex size-(--badge-size) cursor-pointer items-center justify-center rounded-card-inner transition hover:bg-muted/10"
		>
			<svg
				width="20"
				height="20"
				viewBox="0 0 16 16"
				fill="currentColor"
				xmlns="http://www.w3.org/2000/svg"
			>
				<rect
					x="0"
					y="7.5"
					width="16"
					height="1.5"
					rx="0.5"
					class="origin-center translate-y-[-3.5px] transition-transform duration-150 group-open/menu:translate-y-0 group-open/menu:rotate-45"
				></rect>
				<rect
					x="0"
					y="7.5"
					width="16"
					height="1.5"
					rx="0.5"
					class="origin-center translate-y-[3.5px] transition-transform duration-150 group-open/menu:translate-y-0 group-open/menu:-rotate-45"
				></rect>
			</svg>
		</summary>

		<nav
			aria-label={t("header.nav_label")}
			class="absolute inset-x-page-gutters-half top-0 z-40 rounded-card bg-surface/80 pbs-(--badge-size) shadow-lg shadow-black/10 backdrop-blur-xl backdrop-saturate-150 transition"
		>
			<div class="h-card-gutters-half"></div>
			<ul class="flex flex-col p-card-gutters-half">
				{
					menuItems.map((item) => (
						<li>
							<a
								aria-label={item.name}
								href={item.href}
								class="flex h-14 w-full items-center rounded-card-inner text-xl font-semibold transition-[background-color,padding] hover:bg-muted/10 hover:ps-card-gutters"
							>
								{item.name}
							</a>
						</li>
					))
				}
				<li>
					<details class="group/collection">
						<summary
							class="flex h-14 w-full cursor-pointer items-center justify-between rounded-card-inner pe-card-gutters text-xl font-semibold transition-[background-color,padding] hover:bg-muted/10 hover:ps-card-gutters"
						>
							<span>{t("nav.collections")}</span>
							<ChevronDownIcon
								size={18}
								class="transition-transform duration-150 group-open/collection:rotate-180"
							/>
						</summary>
						<ul class="flex flex-col ps-card-gutters">
							{
								collectionItems.map((item) => (
									<li>
										<a
											href={item.href}
											class="flex h-12 w-full items-center rounded-card-inner pe-card-gutters text-lg font-medium transition-[background-color,padding] hover:bg-muted/10 hover:ps-card-gutters"
										>
											{item.name}
										</a>
									</li>
								))
							}
						</ul>
					</details>
				</li>
				<li class="w-full pt-3">
					<a
						href={translatePath("/create")}
						class="group/cta flex h-14 shrink-0 items-center justify-center gap-4 rounded-card-inner border-2 border-text ps-4 pe-5 font-serif text-xl font-medium italic transition hover:border-gold hover:bg-gold/10 hover:text-gold"
					>
						<SparklesIcon
							size={24}
							class="transition-transform group-hover/cta:-rotate-3"
						/>
						<span class="pb-px">{t("nav.create")}</span>
					</a>
				</li>
			</ul>
		</nav>
	</details>
</header>

<style>
	header {
		--badge-size: 44px;
		--nav-item-space: 0.75rem;
	}
</style>
