---
import BadgeIcon from "../assets/badge.svg";
import { getRecentRepos, getSortedRepos } from "../utilities/repos";
import palette from "../data/palette.json";
import {
	buildDisplayNames,
	getLocaleFromUrl,
	getUrlWithoutLocale,
	languages,
	useTranslatedPath,
	useTranslations,
} from "../utilities/i18n";
import CommandMenu, { type Group } from "./command-menu.svelte";
import { ChevronDownIcon, LanguagesIcon, SparklesIcon } from "./icons";
import { objectEntries } from "../utilities/object";

let locale = getLocaleFromUrl(Astro.url);
let t = useTranslations(locale);
let translatePath = useTranslatedPath(locale);
let languageNames = buildDisplayNames(locale);

const [sortedRepos, recentRepos] = await Promise.all([
	getSortedRepos(),
	getRecentRepos(),
]);

const repoSlugs = sortedRepos.map((r) => r.slug);

let menuItems = [
	{ name: t("nav.themes"), href: translatePath("/themes") },
	{ name: t("nav.palette"), href: translatePath("/palette") },
];

let collectionItems = [
	{
		name: t("nav.collection.photography"),
		href: translatePath("/collections/photography"),
	},
	{
		name: t("nav.collection.made-with"),
		href: translatePath("/collections/made-with"),
	},
];

let searchGroups: Group[] = [
	{
		heading: t("command.pages"),
		kind: "icon",
		items: [
			{
				label: t("nav.home"),
				href: translatePath("/"),
				icon: "home",
				searchText: t("nav.home").toLowerCase(),
			},
			{
				label: t("nav.themes"),
				href: translatePath("/themes"),
				icon: "folder",
				searchText: t("nav.themes").toLowerCase(),
			},
			{
				label: t("nav.palette"),
				href: translatePath("/palette"),
				icon: "rainbow",
				searchText: t("nav.palette").toLowerCase(),
			},
			{
				label: t("nav.create"),
				href: translatePath("/create"),
				icon: "sparkles",
				searchText: t("nav.create").toLowerCase(),
			},
			{
				label: t("nav.collection.photography"),
				href: translatePath("/collections/photography"),
				icon: "camera",
				searchText: t("nav.collection.photography").toLowerCase(),
			},
			{
				label: t("nav.collection.made-with"),
				href: translatePath("/collections/made-with"),
				icon: "heart",
				searchText: t("nav.collection.made-with").toLowerCase(),
			},
		],
	},
	{
		heading: t("nav.themes"),
		kind: "theme",
		items: sortedRepos.map((r) => ({
			label: r.name,
			href: translatePath(`/themes/${r.slug}`),
			icon: r.category,
			userstyles: r.userstyles,
			searchText: r.searchText,
		})),
	},
	{
		heading: t("nav.palette"),
		kind: "color",
		items: palette.main.map((color) => ({
			label: color.name,
			href: translatePath(`/palette/${color.slug}`),
			icon: color.slug,
			searchText: color.name.toLowerCase(),
		})),
	},
	{
		heading: t("command.community"),
		kind: "icon",
		items: [
			{
				label: "Email",
				href: "mailto:hi@rosepinetheme.com",
				icon: "inbox",
				searchText: "email",
			},
			{
				label: "Discord",
				href: "/discord",
				icon: "discord",
				searchText: "discord",
			},
			{
				label: "GitHub",
				href: "https://github.com/rose-pine",
				icon: "github",
				searchText: "github",
			},
		],
	},
];

let defaultGroups: Group[] = [
	searchGroups[0],
	{
		heading: t("command.recent_themes"),
		kind: "theme",
		items: recentRepos.map((r) => ({
			label: r.name,
			href: translatePath(`/themes/${r.slug}`),
			icon: r.category,
			searchText: r.searchText,
		})),
	},
	...searchGroups.slice(2),
];
---

<header
	class="relative wrapper mt-page-start flex items-center gap-(--nav-item-space-lg) py-card-gutters-half"
>
	<a
		title={t("nav.home")}
		href={translatePath("/")}
		class="z-50 flex shrink-0 items-center gap-3 rounded-lg"
	>
		<BadgeIcon class="size-(--badge-size) shrink-0" />
		<span class="pe-1 font-serif text-xl font-medium tracking-tight italic"
			>Rosé Pine</span
		>
	</a>

	<div
		class="z-50 flex flex-1 items-center justify-end gap-(--nav-item-space-lg)"
	>
		<CommandMenu
			client:only="svelte"
			{defaultGroups}
			{searchGroups}
			{repoSlugs}
		/>

		<details class="dropdown">
			<summary
				class="button button-ghost max-md:h-(--badge-size) max-md:rounded-card-inner"
			>
				<LanguagesIcon class="button-icon" />
				<ChevronDownIcon class="summary-caret" />
			</summary>
			<ul role="list" class="dropdown-menu dropdown-menu-align-end">
				{
					objectEntries(languages).map(([lang, { name }]) => {
						let localisedName = languageNames.of(lang) ?? name;
						return (
							<li>
								<a
									href={`${translatePath(getUrlWithoutLocale(Astro.url), lang)}?lang=${lang}`}
									class="dropdown-item"
									aria-current={locale === lang ? "page" : undefined}
								>
									<div class="flex flex-wrap items-center gap-1.5 leading-tight">
										<span>{name}</span>
										{name !== localisedName && (
											<span class="text-xs text-subtle">{localisedName}</span>
										)}
									</div>
								</a>
							</li>
						);
					})
				}
			</ul>
		</details>

		<div class="z-50 h-7 w-px bg-text/20"></div>
	</div>

	<nav aria-label={t("nav.header_label")} class="hidden lg:block">
		<ul class="flex items-center gap-(--nav-item-space)">
			{
				menuItems.map((item) => (
					<li>
						<a href={item.href} class="button button-ghost">
							{item.name}
						</a>
					</li>
				))
			}
			<li>
				<details class="dropdown">
					<summary class="button button-ghost">
						{t("nav.collections")}
						<ChevronDownIcon class="summary-caret" />
					</summary>
					<div class="dropdown-menu dropdown-menu-align-end">
						{
							collectionItems.map((item) => (
								<a href={item.href} class="dropdown-item">
									{item.name}
								</a>
							))
						}
					</div>
				</details>
			</li>
			<li>
				<a href={translatePath("/create")} class="button button-outline">
					<SparklesIcon size={16} class="button-icon" />
					<span class="pbe-px">{t("nav.create")}</span>
				</a>
			</li>
		</ul>
	</nav>

	<details class="animate-details group/menu block select-none lg:hidden">
		<summary
			class="button button-ghost relative z-50 size-(--badge-size) rounded-card-inner"
		>
			<svg
				viewBox="0 0 16 16"
				fill="currentColor"
				xmlns="http://www.w3.org/2000/svg"
				class="button-icon"
			>
				<rect
					x="0"
					y="7.5"
					width="16"
					height="1.5"
					rx="0.5"
					class="origin-center translate-y-[-3.5px] transition-transform duration-150 group-open/menu:translate-y-0 group-open/menu:rotate-45"
				></rect>
				<rect
					x="0"
					y="7.5"
					width="16"
					height="1.5"
					rx="0.5"
					class="origin-center translate-y-[3.5px] transition-transform duration-150 group-open/menu:translate-y-0 group-open/menu:-rotate-45"
				></rect>
			</svg>
		</summary>

		<nav
			aria-label={t("nav.header_label")}
			class="card absolute inset-x-page-gutters-half top-0 z-40 bg-surface/80 pbs-(--badge-size) shadow-lg shadow-black/10 backdrop-blur-xl backdrop-saturate-150 transition"
		>
			<div class="h-card-gutters-half"></div>
			<ul class="flex flex-col p-card-gutters-half">
				{
					menuItems.map((item) => (
						<li>
							<a
								aria-label={item.name}
								href={item.href}
								class="flex h-14 w-full items-center rounded-card-inner text-xl font-semibold transition-[background-color,padding] hover:bg-muted/10 hover:ps-card-gutters"
							>
								{item.name}
							</a>
						</li>
					))
				}
				<li>
					<details>
						<summary
							class="flex h-14 w-full items-center justify-between rounded-card-inner pe-card-gutters text-xl font-semibold transition-[background-color,padding] hover:bg-muted/10 hover:ps-card-gutters"
						>
							<span>{t("nav.collections")}</span>
							<ChevronDownIcon class="summary-caret" />
						</summary>
						<ul class="flex flex-col ps-card-gutters">
							{
								collectionItems.map((item) => (
									<li>
										<a
											href={item.href}
											class="flex h-12 w-full items-center rounded-card-inner pe-card-gutters text-lg font-medium transition-[background-color,padding] hover:bg-muted/10 hover:ps-card-gutters"
										>
											{item.name}
										</a>
									</li>
								))
							}
						</ul>
					</details>
				</li>
				<li class="w-full pt-3">
					<a
						href={translatePath("/create")}
						class="group/cta flex h-14 shrink-0 items-center justify-center gap-4 rounded-card-inner border-2 border-text ps-4 pe-5 font-serif text-xl font-medium italic transition hover:border-gold hover:bg-gold/10 hover:text-gold"
					>
						<SparklesIcon
							size={24}
							class="transition-transform group-hover/cta:-rotate-3"
						/>
						<span class="pbe-px">{t("nav.create")}</span>
					</a>
				</li>
			</ul>
		</nav>
	</details>
</header>

<style>
	header {
		--badge-size: 44px;
		--nav-item-space: 0.375rem;
		--nav-item-space-lg: calc(var(--nav-item-space) * 2);
	}
</style>
