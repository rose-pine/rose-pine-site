---
import BadgeIcon from "../assets/badge.svg";
import { getRecentRepos, getSortedRepos } from "../utilities/repos";
import palette from "../data/palette.json";
import {
	buildDisplayNames,
	getLocaleFromUrl,
	getUrlWithoutLocale,
	languages,
	useTranslatedPath,
	useTranslations,
} from "../utilities/i18n";
import CommandMenu, { type Group } from "./command-menu.svelte";
import Dropdown from "./dropdown.svelte";
import { LanguagesIcon, SparklesIcon } from "./icons";
import { objectEntries } from "../utilities/object";

let locale = getLocaleFromUrl(Astro.url);
let t = useTranslations(locale);
let translatePath = useTranslatedPath(locale);
let languageNames = buildDisplayNames(locale);

const [sortedRepos, recentRepos] = await Promise.all([
	getSortedRepos(),
	getRecentRepos(),
]);

const repoSlugs = sortedRepos.map((r) => r.slug);

let menuItems = [
	{ name: t("nav.themes"), href: translatePath("/themes") },
	{ name: t("nav.palette"), href: translatePath("/palette") },
];

let collectionItems = [
	{
		name: t("nav.collection.photography"),
		href: translatePath("/collections/photography"),
	},
	{
		name: t("nav.collection.made-with"),
		href: translatePath("/collections/made-with"),
	},
];

let searchGroups: Group[] = [
	{
		heading: t("command.pages"),
		kind: "icon",
		items: [
			{
				label: t("nav.home"),
				href: translatePath("/"),
				icon: "home",
				searchText: t("nav.home").toLowerCase(),
			},
			{
				label: t("nav.themes"),
				href: translatePath("/themes"),
				icon: "folder",
				searchText: t("nav.themes").toLowerCase(),
			},
			{
				label: t("nav.palette"),
				href: translatePath("/palette"),
				icon: "rainbow",
				searchText: t("nav.palette").toLowerCase(),
			},
			{
				label: t("nav.create"),
				href: translatePath("/create"),
				icon: "sparkles",
				searchText: t("nav.create").toLowerCase(),
			},
			{
				label: t("nav.collection.photography"),
				href: translatePath("/collections/photography"),
				icon: "camera",
				searchText: t("nav.collection.photography").toLowerCase(),
			},
			{
				label: t("nav.collection.made-with"),
				href: translatePath("/collections/made-with"),
				icon: "heart",
				searchText: t("nav.collection.made-with").toLowerCase(),
			},
		],
	},
	{
		heading: t("nav.themes"),
		kind: "theme",
		items: sortedRepos.map((r) => ({
			label: r.name,
			href: translatePath(`/themes/${r.slug}`),
			icon: r.category,
			userstyles: r.userstyles,
			searchText: r.searchText,
		})),
	},
	{
		heading: t("nav.palette"),
		kind: "color",
		items: palette.main.map((color) => ({
			label: color.name,
			href: translatePath(`/palette/${color.slug}`),
			icon: color.slug,
			searchText: color.name.toLowerCase(),
		})),
	},
	{
		heading: t("command.community"),
		kind: "icon",
		items: [
			{
				label: "Email",
				href: "mailto:hi@rosepinetheme.com",
				icon: "inbox",
				searchText: "email",
			},
			{
				label: "Discord",
				href: "/discord",
				icon: "discord",
				searchText: "discord",
			},
			{
				label: "GitHub",
				href: "https://github.com/rose-pine",
				icon: "github",
				searchText: "github",
			},
		],
	},
];

let defaultGroups: Group[] = [
	searchGroups[0],
	{
		heading: t("command.recent_themes"),
		kind: "theme",
		items: recentRepos.map((r) => ({
			label: r.name,
			href: translatePath(`/themes/${r.slug}`),
			icon: r.category,
			searchText: r.searchText,
		})),
	},
	...searchGroups.slice(2),
];
---

<nav
	data-root
	aria-label={t("nav.header_label")}
	class="relative wrapper mt-page-start flex flex-wrap items-center gap-3 py-page-gutters-half"
	style="--insignia-size: 44px"
>
	<div class="z-50">
		<a
			href={translatePath("/")}
			title={t("nav.home")}
			class="flex shrink-0 items-center gap-3 font-serif text-xl font-medium tracking-tight whitespace-nowrap italic"
		>
			<BadgeIcon class="size-(--insignia-size) shrink-0" />
			Rosé Pine
		</a>
	</div>

	<div class="flex flex-1 items-center justify-end gap-3">
		<div class="z-50 flex items-center gap-3">
			<CommandMenu
				client:only="svelte"
				{defaultGroups}
				{searchGroups}
				{repoSlugs}
			/>

			<Dropdown triggerSize="touch" align="end">
				<Fragment slot="trigger"><LanguagesIcon /></Fragment>

				<ul>
					{
						objectEntries(languages).map(([lang, { name }]) => {
							let localisedName = languageNames.of(lang) ?? name;
							return (
								<li>
									<a
										aria-current={locale === lang ? "true" : undefined}
										href={translatePath(getUrlWithoutLocale(Astro.url), lang)}
									>
										<div class="flex flex-col flex-wrap">
											{name}
											{name.toLowerCase() !== localisedName.toLowerCase() && (
												<div class="text-xs text-subtle">{localisedName}</div>
											)}
										</div>
									</a>
								</li>
							);
						})
					}
				</ul>
			</Dropdown>

			<div class="h-7 w-px bg-text/20"></div>
		</div>

		<ul class="hidden items-center gap-3 lg:flex">
			{
				menuItems.map((item) => (
					<li>
						<a href={item.href} class="button button-ghost">
							{item.name}
						</a>
					</li>
				))
			}

			<li>
				<Dropdown align="end">
					<Fragment slot="trigger">{t("nav.collections")}</Fragment>

					<ul>
						{
							collectionItems.map((item) => (
								<li>
									<a href={item.href}>{item.name}</a>
								</li>
							))
						}
					</ul>
				</Dropdown>
			</li>

			<li>
				<a href={translatePath("/create")} class="button button-outline">
					<SparklesIcon size={16} />
					{t("nav.create")}
				</a>
			</li>
		</ul>

		<details class="animate-details group/menu block select-none lg:hidden">
			<summary class="button button-ghost relative z-50 max-lg:button-lg">
				<svg
					viewBox="0 0 16 16"
					fill="currentColor"
					xmlns="http://www.w3.org/2000/svg"
				>
					<rect
						x="0"
						y="7.5"
						width="16"
						height="1.5"
						rx="0.5"
						class="origin-center translate-y-[-3.5px] transition-transform duration-150 group-open/menu:translate-y-0 group-open/menu:rotate-45"
					></rect>
					<rect
						x="0"
						y="7.5"
						width="16"
						height="1.5"
						rx="0.5"
						class="origin-center translate-y-[3.5px] transition-transform duration-150 group-open/menu:translate-y-0 group-open/menu:-rotate-45"
					></rect>
				</svg>
			</summary>

			<div
				class="absolute inset-x-page-gutters-half top-0 z-40 overflow-hidden rounded-card border border-overlay bg-surface/80 pbs-[calc(var(--spacing-page-gutters-half)+var(--insignia-size))] shadow-md shadow-black/5 backdrop-blur-xl backdrop-saturate-150"
			>
				<ul class="flex flex-col p-page-gutters-half">
					{
						[...menuItems, ...collectionItems].map((item) => (
							<li>
								<a
									aria-label={item.name}
									href={item.href}
									class="flex h-14 w-full shrink-0 items-center rounded-card-inner text-xl font-semibold transition-[background-color,padding] select-none hover:bg-muted/10 motion-safe:hover:px-5 motion-reduce:px-5"
								>
									{item.name}
								</a>
							</li>
						))
					}

					<li>
						<a
							href={translatePath("/create")}
							class="button button-outline button-full mt-3 button-xl"
						>
							<SparklesIcon />
							{t("nav.create")}
						</a>
					</li>
				</ul>
			</div>
		</details>
	</div>
</nav>
