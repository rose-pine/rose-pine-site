	},
	"devDependencies": {
		"@types/node": "^26.6.6",
		"prettier": "^3.10.1",
		"prettier-plugin-astro": "^0.14.1",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"sharp": "^0.35.5",
